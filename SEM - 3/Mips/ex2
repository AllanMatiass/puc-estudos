.data
array: .word 10, 20, 30, 40, 50   # lista de ints

.text
main:
    li $s0, 0        # sum = 0
    li $s1, 5        # len = 5
    la $s2, array    # base do array

    li $t0, 0        # i = 0

while:
    beq $t0, $s1, exit   # if i == len, sai
    
    # calcula offset (i * 4)
    sll $t1, $t0, 2
    
    # pega o endereco do array + a posição
     add $t2, $t1, $s2
     
     # carrega o endereço
     lw $t3, 0($t2)
     
     # adiciona a sum
      add $s0, $s0, $t3 
      
    
      addi $t0, $t0, 1     # i++
    j while

exit: